# ProofChain 1.0.0 — supported runtime configuration.
# Copy to .env, replace every placeholder, and never commit the result.
# Placeholders are not credentials: no value in this file is usable anywhere.
# Secrets are read only from the environment; the application never generates or defaults one.

# --- Docker Compose PostgreSQL service ---
POSTGRES_DB=proofchain
POSTGRES_USER=proofchain
POSTGRES_PASSWORD=<local-only-secret>
# Host port the database is published on. Change it when 5432 is already taken.
POSTGRES_PORT=5432

# --- Docker Compose application service ---
# Host port the API is published on; the container always listens on 8080 internally.
APP_PORT=8080
# Size of the bounded tmpfs mounted at /tmp for JVM and multipart temporary data.
# The container root filesystem is read-only; this and the evidence volume are the only writable paths.
PROOFCHAIN_TMPFS_SIZE=256m
# Optional, build time only. Path to a PEM certificate (or bundle) for a network that terminates TLS
# on the way to Maven Central. It is trusted inside the throwaway build stage only and never reaches
# the runtime image. Leave it unset on a normal network.
# PROOFCHAIN_BUILD_CA_FILE=/path/to/corporate-ca.crt

# --- Application datasource ---
# Required in the `local` and `container` profiles; startup fails when the username or password is empty.
# Use DB_HOST=localhost with the `local` profile and DB_HOST=postgres with the `container` profile.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proofchain
DB_USERNAME=proofchain
DB_PASSWORD=<local-only-secret>

# --- Active profile ---
# Exactly three profiles exist: local (host execution), container (Docker Compose execution) and
# test (automated tests, activated by the build). The application defaults to `local`.
SPRING_PROFILES_ACTIVE=local

# --- Evidence storage ---
# Defaults to ./storage under `local` and /var/lib/proofchain/storage under `container`.
# The directory must be a real, writable directory or be creatable as one.
PROOFCHAIN_STORAGE_ROOT=./storage

# --- JWT ---
# Required. Standard Base64 decoding to at least 32 random bytes; generate with `openssl rand -base64 32`.
# There is no default and no fallback: a missing, malformed or weak secret stops startup.
PROOFCHAIN_JWT_SECRET=<base64-encoded-local-only-secret-at-least-32-bytes>
# ISO-8601 duration, strictly positive. The application default is PT30M.
PROOFCHAIN_JWT_ACCESS_TOKEN_TTL=PT30M

# --- Upload and request limits ---
# Evidence file limit and the slightly larger multipart envelope carrying the JSON metadata part.
PROOFCHAIN_MAX_FILE_SIZE=50MB
PROOFCHAIN_MAX_REQUEST_SIZE=51MB
# Non-file limits. Every value must be finite and strictly positive.
PROOFCHAIN_MAX_HTTP_HEADER_SIZE=16KB
PROOFCHAIN_MAX_FORM_POST_SIZE=256KB
PROOFCHAIN_MAX_SWALLOW_SIZE=2MB
PROOFCHAIN_MAX_PARAMETER_COUNT=256
PROOFCHAIN_MAX_PART_COUNT=16
PROOFCHAIN_MAX_PART_HEADER_SIZE=8KB

# --- Timeouts ---
# HTTP connector timeouts.
PROOFCHAIN_HTTP_CONNECTION_TIMEOUT=20s
PROOFCHAIN_HTTP_KEEP_ALIVE_TIMEOUT=20s
# Graceful shutdown drain window; positive and at most 5 minutes.
PROOFCHAIN_SHUTDOWN_TIMEOUT=30s
# Database connection acquisition budget in milliseconds (250..60000). No retry is performed.
PROOFCHAIN_DB_CONNECTION_TIMEOUT_MS=10000
# Connection validation budget in milliseconds; must be smaller than the acquisition budget.
PROOFCHAIN_DB_VALIDATION_TIMEOUT_MS=5000
# Startup probe in milliseconds; 1 proves one connection and then fails closed. Negative values are rejected.
PROOFCHAIN_DB_STARTUP_TIMEOUT_MS=1
# PostgreSQL lock wait applied to every pooled connection; positive and at most 5 minutes.
PROOFCHAIN_DB_LOCK_TIMEOUT=10s

# --- Password policy ---
PROOFCHAIN_PASSWORD_MIN_LENGTH=12
PROOFCHAIN_PASSWORD_MAX_LENGTH=128
# BCrypt cost factor, 4..31.
PROOFCHAIN_BCRYPT_STRENGTH=12

# --- CORS ---
# Default deny. Empty means no cross-origin request is ever allowed. Only comma-separated explicit
# origins such as https://console.example.org are accepted; a `*` entry is rejected and stops startup.
PROOFCHAIN_CORS_ALLOWED_ORIGINS=

# --- Bootstrap administrator ---
# Opt-in and disabled by default. When enabled it is idempotent: it does nothing if an active ADMIN exists.
PROOFCHAIN_BOOTSTRAP_ADMIN_ENABLED=false
PROOFCHAIN_BOOTSTRAP_ADMIN_USERNAME=
PROOFCHAIN_BOOTSTRAP_ADMIN_EMAIL=
PROOFCHAIN_BOOTSTRAP_ADMIN_PASSWORD=
