POSTGRES_DB=proofchain
POSTGRES_USER=proofchain
POSTGRES_PASSWORD=<local-only-secret>
POSTGRES_PORT=5432

DB_HOST=localhost
DB_PORT=5432
DB_NAME=proofchain
DB_USERNAME=proofchain
DB_PASSWORD=<local-only-secret>

PROOFCHAIN_STORAGE_ROOT=./storage
# Standard Base64 value that decodes to at least 32 random bytes.
PROOFCHAIN_JWT_SECRET=<base64-encoded-local-only-secret-at-least-32-bytes>
# ISO-8601 duration; the application default is PT30M.
PROOFCHAIN_JWT_ACCESS_TOKEN_TTL=PT30M
PROOFCHAIN_MAX_FILE_SIZE=50MB
PROOFCHAIN_PASSWORD_MIN_LENGTH=12
PROOFCHAIN_PASSWORD_MAX_LENGTH=128
PROOFCHAIN_BCRYPT_STRENGTH=12

PROOFCHAIN_BOOTSTRAP_ADMIN_ENABLED=false
PROOFCHAIN_BOOTSTRAP_ADMIN_USERNAME=
PROOFCHAIN_BOOTSTRAP_ADMIN_EMAIL=
PROOFCHAIN_BOOTSTRAP_ADMIN_PASSWORD=
